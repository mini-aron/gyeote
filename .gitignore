# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 로컬 LLM(분석) 호출 로그 — 개인 로컬 기록, 공유 대상 아님
/.logs

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase: 데이터 전용 SQL(INSERT/UPDATE/DELETE — 시드/임포트/일회성 데이터
# 교정)은 구조 변경(DDL)이 아니라서 git에 커밋하지 않고 로컬에만 둔다.
# 새로 만들 때 파일명에 `_data.sql`을 붙이면 자동으로 무시된다.
supabase/migrations/*_data.sql

# oh-my-claudecode: keep project-memory.json (shared project context),
# ignore per-session/machine runtime state
/.omc/state
/.omc
# local Claude Code project harness — not shared via the repo
/CLAUDE.md
/.claude/rules
/.claude/hooks
/.claude/settings.local.json
