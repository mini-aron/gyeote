NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 맥북에서 도는 로컬 Ollama 서버 주소. 비워두면 http://localhost:11434 사용.
# Vercel 등 원격 배포 환경에서는 맥북을 가리키는 터널 주소로 반드시 바꿔야
# 한다 — 비어있거나 접속 안 되면 F-03/F-06 분석이 시간대 기반 폴백으로
# 조용히 전환된다.
OLLAMA_BASE_URL=

# 배포 환경에만 설정 — 값이 있으면 Ollama 대신 OpenAI(gpt-5-mini) 사용
OPENAI_API_KEY=

# 회원 탈퇴 시 카카오 연결 끊기(unlink)용 Admin Key. 카카오 개발자 콘솔 > 앱 키.
KAKAO_ADMIN_KEY=
